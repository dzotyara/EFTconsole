{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EFTconsole",
  "version": "0.2.0",
  "identifier": "com.github.dzotyara.eftconsole",
  "build": {
    "frontendDist": "../src/renderer",
    "beforeDevCommand": "node scripts/vendor.js",
    "beforeBuildCommand": "node scripts/vendor.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
